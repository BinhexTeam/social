<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="partner_binhex_bot_ai" model="res.partner">
        <field name="name">Binhex Bot AI</field>
        <field
            name="image_1920"
            type="base64"
            file="ollama_integration/static/description/binhexbot.jpg"
        />
    </record>
    <record id="user_binhex_bot_ai" model="res.users">
        <field name="login">binhexbotai@binhex.cloud</field>
        <field name="password">binhexbotai</field>
        <field name="partner_id" ref="ollama_integration.partner_binhex_bot_ai" />
        <field name="company_id" ref="base.main_company" />
        <field name="company_ids" eval="[Command.link(ref('base.main_company'))]" />
        <field name="groups_id" eval="[Command.link(ref('base.group_user'))]" />
    </record>
    <record id="ir_cron_update_user_online" model="ir.cron">
        <field name="name">Update Bots online status</field>
        <field name="model_id" ref="model_res_users" />
        <field name="state">code</field>
        <field name="code">model._keep_user_online()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
