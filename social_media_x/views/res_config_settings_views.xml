<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.social_media_x</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[hasclass('o_social_network_settings')]"
                position="inside"
            >
                <setting string="X Account">
                    <field name="x_use_account" />
                    <div class="content-group" invisible="not x_use_account">
                        <div class="mt16">
                            <label
                                for="x_api_key"
                                class="col-3 col-lg-3 o_form_label"
                            />
                            <field name="x_api_key" class="oe_inline" />
                        </div>
                        <div class="mt16">
                            <label
                                for="x_api_secret"
                                class="col-3 col-lg-3 o_form_label"
                            />
                            <field
                                name="x_api_secret"
                                password="True"
                                class="oe_inline"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
