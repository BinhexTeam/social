<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
	<t t-name="connector_social_base.SocialNetworkFilter">
		<div
            class="d-flex justify-content-lg-between p-lg-1 m-1 px-1 flex-column bg-secondary flex-lg-row network-filter"
        >
			<div t-if="filterGranularity" class="d-flex justify-content-between mx-1 w-100">
				<select class="form-control w-100 my-2 mx-lg-2" t-ref="chart_filter_type">
					<option value="day">
						Day
					</option>
					<option value="week" selected="selected">
						Week
					</option>
					<option value="month">
						Month
					</option>
				</select>
			</div>
			<div
                t-if="campaigns &amp;&amp; campaigns.length > 0"
                class="d-flex justify-content-between mx-1 w-100"
            >
				<select
                    class="form-select w-100 my-2 mx-lg-2"
                    aria-label="Campaigns"
                    t-ref="filter_campaign"
                >
					<option value="">
						Select campaign...
					</option>
					<option
                        t-foreach="campaigns"
                        t-as="campaign"
                        t-key="campaign.id"
                        t-att-value="campaign.id"
                    >
						<t t-esc="campaign.name" />
					</option>
				</select>
			</div>
			<div
                t-if="posts &amp;&amp; posts.length > 0"
                class="d-flex justify-content-between mx-1 w-100"
            >
				<select
                    class="form-select w-100 my-2 mx-lg-2 w-100"
                    aria-label="Posts"
                    t-ref="filter_post"
                >
					<option value="">
						Select post...
					</option>
					<option t-foreach="posts" t-as="post" t-key="post.id" t-att-value="post.id">
						<t t-esc="post.name" />
					</option>
				</select>
			</div>
			<div class="d-flex justify-content-between py-2">
				<input
                    type="date"
                    class="form-control w-50 mx-2"
                    placeholder="Select start date"
                    t-ref="start_date"
                    t-on-change="onValidateRangeDate"
                />
				<input
                    type="date"
                    class="form-control w-50"
                    placeholder="Select end date"
                    t-ref="end_date"
                    t-on-change="onValidateRangeDate"
                />
			</div>
			<div class="d-flex justify-content-center align-items-center">
				<button class="btn btn-primary mx-2" t-on-click="onFilter">
					<span class="social-loader d-none" />
					Filter
				</button>
				<button class="btn btn-info mx-2" t-on-click="onClearFilter">
					Clear
				</button>
			</div>
		</div>
	</t>
</templates>
