<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="connector_social_base.SocialNetworkAdsAccount">
        <div class="social-network-ads-account">
            <div class="d-flex flex-column">
            <ControlPanel>
                <t t-set-slot="control-panel-create-button">
                <button class="btn btn-primary mx-2" t-on-click="onUpdateAllAds">
                    <i
                                t-if="!social_state.loaderAds"
                                class="fa fa-refresh px-1"
                                aria-hidden="true"
                            />
                    <span
                                class="social-loader"
                                t-if="social_state.loaderAds"
                            /> Sync ads
                </button>
                </t>

                <t t-set-slot="control-panel-navigation-additional">
                    <SocialNetworkFilter
                            filter.bind="onFilterAds"
                            searchEnable="true"
                        />
                </t>
			</ControlPanel>
        </div>


            <div class="row p-lg-3 p-1 social-ads">
                <div
                    class="px-2 col-12 col-lg-3"
                    t-foreach="ads"
                    t-as="ad"
                    t-key="ad.id"
                >
                        <SocialNetworkAds socialAds="ad" />
                </div>
            </div>
        </div>
    </t>
    </templates>
