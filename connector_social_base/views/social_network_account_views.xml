<odoo>

    <record model="ir.ui.view" id="social_account_form_view">
        <field name="name">social.network.account.form</field>
        <field name="model">social.network.account</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="username" />
                            <field name="media_id" />
                        </group>
                        <group>
                            <field name="create_uid" />
                            <field name="create_date" />
                            <field name="media_type" invisible="1" />
                        </group>
                    </group>
                    <notebook invisible="media_type != 'linkedin'">
                        <page name="account_token" string="Token">
                            <div class="col-6 mb-3">
                                <button
                                    type="object"
                                    name="validate_active_access_token"
                                    class="oe_highlight"
                                    string="Token valid service"
                                />
                            </div>
                            <group>
                                <field
                                    name="is_valid_token_access"
                                    widget="boolean_toggle"
                                    readonly="1"
                                />
                            </group>
                            <group>
                                <field name="expire_access_token_date" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="social_account_tree_view">
        <field name="name">social.network.account.tree</field>
        <field name="model">social.network.account</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name" />
                <field name="username" />
                <field name="media_id" />
                <field name="create_uid" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="social_account_act_window_tree">
        <field name="name">Accounts</field>
        <field name="res_model">social.network.account</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
