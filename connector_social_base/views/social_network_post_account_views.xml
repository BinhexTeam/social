<odoo>

    <record model="ir.ui.view" id="social_network_post_account_kanban_view">
        <field name="name">social.network.stream.post.view.kanban</field>
        <field name="model">social.network.post.account</field>
        <field name="arch" type="xml">
            <kanban
                create="0"
                edit="0"
                delete="0"
                quick_create="0"
                js_class="social_network_kanban"
                group_by="account_id"
            >
                <field name="message" />
                <field name="published_date" />
                <field name="image_urls" />
                <field name="comments_count" />
                <field name="likes_count" />
                <field name="post_account_url" />
                <field name="author" />
                <field name="media_type" />
                <templates>
                    <t t-name="kanban-menu">
                        <div class="p-1">
                            <a
                                role="menuitem"
                                type="object"
                                name="delete_post_account"
                            >Delete post</a>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="rounded cursor-pointer oe_kanban_social_dashboard d-flex flex-column justify-content-between"
                        >
                            <t t-call="connector_social_base.postAccountHeader" />

                            <div class="oe_kanban_content">

                                <t
                                    t-set="images"
                                    t-value="JSON.parse(record.image_urls.raw_value)"
                                />
                                <t
                                    t-call="connector_social_base.postAccountMessageImages"
                                />
                            </div>
                            <div class="oe_kanban_footer">
                                <t t-call="connector_social_base.postAccountFooter" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="social_network_post_account_view_search">
        <field name="name">Search field and group by</field>
        <field name="model">social.network.post.account</field>
        <field name="arch" type="xml">
            <search>
                <group expand="0" string="Group By">
                    <filter
                        string="Accounts"
                        name="account"
                        domain="[]"
                        context="{'group_by': 'account_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="social_network_post_account_act_window_kanban"
    >
        <field name="name">Dashboard</field>
        <field name="res_model">social.network.post.account</field>
        <field name="view_mode">kanban</field>
        <field name="context">{
            "search_default_account_id": 1,
        }</field>
        <field name="search_view_id" ref="social_network_post_account_view_search" />
    </record>

    <template id="connector_social_base.social_network_post_preview">
        <div class="mb-2 p-3 shadow social-text-justify ">
            <div class="d-flex justify-content-start align-items-center">
                <img
                    t-if="media_id.image"
                    width="40"
                    height="40"
                    t-attf-src="connector_social_#{media_id.media_type}/static/img/#{media_id.media_type}.png"
                    class="img img-fluid rounded"
                    loading="lazy"
                />
                <t t-esc="author" />
            </div>
            <div class="d-flex  p-2">
                <t t-out="message" />
            </div>
            <div
                t-if="image_ids"
                class="d-flex justify-content-between align-items-center  p-2"
            >
                <div
                    class="d-flex justify-content-center flex-wrap gap-3 h-75 p-sm-1 p-lg-3"
                >
                    <t t-foreach="image_ids" t-as="image_id" t-key="image_id.id">
                        <img
                            t-attf-src="/web/image/#{image_id.id}"
                            width="150"
                            height="130"
                            class="img-fluid img-posts"
                        />
                    </t>
                </div>
            </div>
        </div>
    </template>

</odoo>
