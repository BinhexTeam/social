<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.connector_social_base</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Social network"
                    data-string="Social network"
                    name="connector_social_base"
                    groups="base.group_system"
                >
                    <block title="Accounts" class="o_social_network_settings" />

                </app>
            </xpath>
        </field>
    </record>

    <record
        id="action_connector_social_base_config_settings"
        model="ir.actions.act_window"
    >
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form" />
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'connector_social_base', 'bin_size': False}
        </field>
    </record>
</odoo>
